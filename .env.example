LOCAL_APP_HOST=127.0.0.1
LOCAL_APP_PORT=3000
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.4
OPENAI_RATE_LIMIT_WINDOW_SECONDS=300
OPENAI_MAX_REQUESTS_PER_WINDOW=8
OPENAI_MAX_CONCURRENT_REQUESTS=1
OPENAI_REQUEST_TIMEOUT_MS=25000
OPENAI_UPSTREAM_RETRY_ATTEMPTS=2
FIREBASE_API_KEY=replace-with-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
FIREBASE_APP_ID=replace-with-firebase-app-id
FIREBASE_MEASUREMENT_ID=replace-with-firebase-measurement-id
